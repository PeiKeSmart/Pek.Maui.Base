<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JPushTestDemo.MainPage"
             Title="JPush Test Demo">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Image
                Source="dotnet_bot.png"
                HeightRequest="100"
                Aspect="AspectFit" />

            <Label
                Text="极光推送测试Demo"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center" />

            <Label
                Text="JPush Integration Test"
                Style="{StaticResource SubHeadline}"
                HorizontalOptions="Center" />

            <!-- Registration ID Section -->
            <Frame BackgroundColor="LightBlue" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="注册信息" FontAttributes="Bold" />
                    <Label x:Name="RegistrationIdLabel" Text="Registration ID: 未获取" />
                    <Button 
                        x:Name="GetRegIdBtn"
                        Text="获取Registration ID" 
                        Clicked="OnGetRegistrationIdClicked"
                        BackgroundColor="DodgerBlue"
                        TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Alias and Tags Section -->
            <Frame BackgroundColor="LightGreen" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="别名和标签设置" FontAttributes="Bold" />
                    <Entry x:Name="AliasEntry" Placeholder="输入别名 (Alias)" />
                    <Entry x:Name="TagsEntry" Placeholder="输入标签 (Tags，逗号分隔)" />
                    <Button 
                        x:Name="SetAliasTagsBtn"
                        Text="设置别名和标签" 
                        Clicked="OnSetAliasTagsClicked"
                        BackgroundColor="Green"
                        TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Test Notification Section -->
            <Frame BackgroundColor="LightCoral" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="通知测试" FontAttributes="Bold" />
                    <Button 
                        x:Name="TestNotificationBtn"
                        Text="发送测试通知" 
                        Clicked="OnTestNotificationClicked"
                        BackgroundColor="Red"
                        TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Push Status Check Section -->
            <Frame BackgroundColor="LightBlue" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="推送状态检查" FontAttributes="Bold" />
                    <Button 
                        x:Name="CheckPushStatusBtn"
                        Text="🔍 检查推送接收状态" 
                        Clicked="OnCheckPushStatusClicked"
                        BackgroundColor="Blue"
                        TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Broadcast History Section -->
            <Frame BackgroundColor="LightGray" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📡 广播历史记录" FontAttributes="Bold" FontSize="16" />
                    <Label Text="查看JPush推送和广播的接收历史，支持多种显示条数选择" FontSize="12" TextColor="DarkGray" />
                    
                    <!-- 主要操作按钮 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">
                        <Button 
                            x:Name="ViewHistoryBtn"
                            Text="📋 快速查看" 
                            Clicked="OnViewHistoryClicked"
                            BackgroundColor="DarkSlateBlue"
                            TextColor="White"
                            FontSize="14"
                            Grid.Column="0" />
                        <Button 
                            x:Name="DetailHistoryBtn"
                            Text="📊 详细管理" 
                            Clicked="OnDetailHistoryClicked"
                            BackgroundColor="DarkBlue"
                            TextColor="White"
                            FontSize="14"
                            Grid.Column="1" />
                    </Grid>
                    
                    <!-- 辅助操作按钮 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,5,0,0">
                        <Button 
                            x:Name="QuickViewRecentBtn"
                            Text="⚡ 最近100条" 
                            Clicked="OnQuickViewRecentClicked"
                            BackgroundColor="Orange"
                            TextColor="White"
                            FontSize="12"
                            Grid.Column="0" />
                        <Button 
                            x:Name="ClearHistoryBtn"
                            Text="🗑️ 清空记录" 
                            Clicked="OnClearHistoryClicked"
                            BackgroundColor="DarkRed"
                            TextColor="White"
                            FontSize="12"
                            Grid.Column="1" />
                    </Grid>
                    
                    <Label x:Name="HistoryInfoLabel" Text="点击上方按钮查看历史记录" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Status Section -->
            <Frame BackgroundColor="LightYellow" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="状态信息" FontAttributes="Bold" />
                    <Label x:Name="StatusLabel" Text="状态: 等待操作..." />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
